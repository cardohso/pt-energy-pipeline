# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# ENTSO-E Transparency Platform security token (request: email transparency@entsoe.eu,
# subject "Restful API access", after registering on the platform).
ENTSOE_API_TOKEN=

# Where the pipeline keeps raw and processed data (local path; in CI this is a checkout
# of the private data repo).
PT_ENERGY_DATA_DIR=./data
